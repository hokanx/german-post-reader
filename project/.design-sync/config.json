  "overrides": {
    "Button": { "cardMode": "column" },
    "Card": { "cardMode": "column" },
    "CardHeader": { "cardMode": "column" },
    "CardTitle": { "cardMode": "column" },
    "CardDescription": { "cardMode": "column" },
    "CardAction": { "cardMode": "column" },
    "CardContent": { "cardMode": "column" },
    "CardFooter": { "cardMode": "column" },
    "Input": { "cardMode": "column" },
    "Label": { "cardMode": "column" },
    "Skeleton": { "cardMode": "column" },

    "Dialog": { "cardMode": "single", "viewport": "700x440" },
    "DialogContent": { "cardMode": "single", "viewport": "700x460", "primaryStory": "WithBody" },
    "DialogHeader": { "cardMode": "single", "viewport": "700x440", "primaryStory": "TitleAndDescription" },
    "DialogTitle": { "cardMode": "single", "viewport": "700x440", "primaryStory": "Default" },
    "DialogDescription": { "cardMode": "single", "viewport": "700x440", "primaryStory": "WithLink" },
    "DialogFooter": { "cardMode": "single", "viewport": "700x440", "primaryStory": "WithCloseButton" },
    "DialogTrigger": { "cardMode": "single", "viewport": "700x440", "primaryStory": "AsButton" },
    "DialogClose": { "cardMode": "single", "viewport": "700x440", "primaryStory": "AsOutlineButton" },
    "DialogOverlay": { "cardMode": "single", "viewport": "700x440", "primaryStory": "BehindADialog" },
    "DialogPortal": { "cardMode": "single", "viewport": "700x440", "primaryStory": "UsedByDialogContent" },
    "Toaster": { "cardMode": "single", "viewport": "560x420", "primaryStory": "Statuses" }
  },
  "extraFonts": [
